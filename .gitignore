# Python leaves these about.
__pycache__/
*.py[cod]
*.egg-info/
.cache/
build/
dist/

# Logs are evidence, not source. The sample is generated by
# examples/make-sample-log.py rather than committed, so a real auth.log cannot
# land here by accident. It would carry usernames and addresses of a real machine.
*.log
*.log.1
*.log.*.gz
auth.log*
secure*

# Editors and environments.
.vscode/
.idea/
.venv/
venv/
